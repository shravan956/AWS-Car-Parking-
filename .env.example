# SmartPark Cloud - Environment Configuration Template
# NOTE: Do NOT commit production secrets or IAM private keys to this file.

# AWS Region Configuration
VITE_AWS_REGION=us-east-1

# AWS IoT Core Broker Configuration (ATS Endpoint)
VITE_AWS_IOT_ENDPOINT=a39v7k2l90-ats.iot.us-east-1.amazonaws.com
VITE_AWS_IOT_MQTT_TOPIC_PREFIX=smartpark/slots

# AWS DynamoDB Table Names
VITE_AWS_DYNAMODB_SLOT_TABLE=SmartPark_Slot_State
VITE_AWS_DYNAMODB_DEVICE_TABLE=SmartPark_IoT_Devices

# AWS S3 Telemetry Archive Bucket
VITE_AWS_S3_ARCHIVE_BUCKET=smartpark-cloud-telemetry-archive

# Application Runtime Engine Mode (DEMO | REAL_AWS)
VITE_APP_MODE=DEMO
